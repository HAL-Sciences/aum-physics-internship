# Copy this file to .env and fill in your real keys there.
# .env is gitignored -- never commit a key. If one ever ends up in a commit,
# treat it as compromised and get it rotated, don't just delete the line.

# The Anthropic SDK reads this automatically.
ANTHROPIC_API_KEY=sk-ant-...

# The OpenAI SDK reads this automatically.
OPENAI_API_KEY=sk-...
